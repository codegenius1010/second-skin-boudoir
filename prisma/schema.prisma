// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Client contact information
model Client {
  id                  String   @id @default(cuid())
  firstName           String
  lastName            String
  emailNormalized     String   @unique
  phoneNormalized     String?  // Allow multiple clients with same phone number
  instagramHandle     String?
  ghlContactId        String?

  sessions            PhotographySession[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([ghlContactId])
}

// Photography session booking metadata
model PhotographySession {
  id                      String   @id @default(cuid())
  clientId                String
  client                  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  sessionType             String   // "private-client" | "collaboration" | "paid-model"
  sessionDate             DateTime?
  sessionLocation         String?
  ghlOpportunityId        String?

  agreementTemplateType   String?  // "standard-boudoir" | "bridal" | "collaboration" | etc
  agreementStatus         String   @default("not_sent") // "not_sent" | "sent" | "viewed" | "signed" | "completed" | "requires_attention" | "unavailable"
  agreementDocumentId     String?
  agreementCompletedAt    DateTime?

  // Admin review status for session prep
  reviewStatus            String   @default("needs_review") // "needs_review" | "reviewed"

  // Secure prep token for access control
  securePrepTokenHash     String?  @unique
  securePrepTokenExpiresAt DateTime?

  intakes                 SessionIntake[]
  webhookDeliveries       WebhookDelivery[]
  consentAuditTrail       ConsentAuditTrail[]

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([clientId])
  @@index([ghlOpportunityId])
  @@index([securePrepTokenHash])
}

// Versioned session intake questionnaire
model SessionIntake {
  id                            String   @id @default(cuid())
  sessionId                     String
  session                       PhotographySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  schemaVersion                 String   @default("1.0")
  status                        String   @default("draft") // "draft" | "submitted"
  submittedAt                   DateTime?

  // Client contact info as entered in form (for comparison with admin setup)
  clientFirstName               String?  // Client-entered first name
  clientLastName                String?  // Client-entered last name
  clientEmail                   String?  // Client-entered email
  clientPhone                   String?  // Client-entered phone

  // Session Vision
  desiredFeelings               String  @default("[]") // JSON array: ["confident", "feminine", "powerful", etc]
  visualStyles                  String  @default("[]") // JSON array: ["soft_romantic", "elegant_timeless", etc]
  posingStyles                  String  @default("[]") // JSON array: ["soft_relaxed", "elegant_feminine", etc]
  posingIntensity               String?  // "classic" | "sensual" | "bold" | "erotic_editorial" | "open_to_discussing" | "unsure"

  // Coverage & Wardrobe
  coveragePreferences           String  @default("[]") // JSON array: ["fully_covered", "robe", "bodysuit", "sheer", "implied", "topless", "nude"]
  coverageDecision              String?  // "prefer_stay_within" | "open_less_coverage" | "open_how_feel" | "undecided" | "no_nudity"
  hardCoverageBoundaries        String?  // Free text: "No frontal nude..."
  poseBoundaries                String?  // Free text: "No X poses..."
  cameraAngleBoundaries         String?  // Free text: "No upskirt angles..."
  wardrobeAdjustmentBoundaries  String?  // Free text: "No lifting shirt..."

  areasToEmphasize              String?  // Free text: "Eyes, waist, legs"
  areasToPhotographDiscreetly   String?  // Free text: "Midsection"

  // Music preferences
  favoriteSong                  String?
  favoriteArtists               String?
  musicGenres                   String  @default("[]") // JSON array
  playlistUrl                   String?
  explicitLyricsAllowed         String?  // "yes" | "no" | "either"
  musicToAvoid                  String?

  // Wardrobe planning
  wardrobePlans                 String  @default("[]") // JSON array: ["lingerie", "bodysuit", "robe", "shirt", "sweater", "dress", "bridal", "heels", "jewelry", "personal_item", "sheets", "unsure"]
  wardrobeGuidanceRequested     Boolean  @default(false)
  clothingSizes                 String?  // "S, 8, 34B..."
  favoriteColorsStyles          String?  // Free text
  dislikedColorsStyles          String?  // Free text

  // Comfort & Support
  mobilityPositioningNotes      String?  // Free text: mobility, positioning concerns
  supportPersonAttending        Boolean  @default(false)
  supportPersonName             String?

  // Instagram & Tagging
  instagramHandle               String?
  instagramTagPermission        String?  // "yes" | "ask_me" | "no"
  collaboratorCreditPermission  String?  // "yes" | "ask_me" | "no"

  // Additional notes
  additionalPrivateNotes        String?  // Free text: anything else to help Matthew
  additionalImageComments       String?  // Free text: special requests for image editing

  // Acknowledgments
  ongoingConsentAcknowledged    Boolean  @default(false)
  accurateInformationAcknowledged Boolean @default(false)  
  // Legal Compliance - MVP
  agreementAccepted             Boolean  @default(false)  // "I have read and agree" checkbox
  agreementAcceptedAt           DateTime?  // Exact timestamp client clicked accept
  emailVerified                 Boolean  @default(false)  // Email is confirmed as client's
  // Optional security info
  submittedIpHash               String?  // SHA-256 hash of IP, never raw IP
  userAgentSummary              String?  // e.g., "Chrome/MacOS"

  // Admin review tracking
  reviewStatus                  String   @default("needs_review") // "needs_review" | "reviewed"

  webhookDeliveries             WebhookDelivery[]
  consentAuditTrail             ConsentAuditTrail[]

  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([submittedAt])
}

// Transactional outbox for reliable webhook delivery
model WebhookDelivery {
  id                      String   @id @default(cuid())
  
  intakeId                String
  intake                  SessionIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  
  sessionId               String
  session                 PhotographySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  destination             String   @default("GHL_SESSION_PREP_WEBHOOK")
  eventType               String   @default("session_prep_submitted")
  schemaVersion           String   @default("1.0")
  
  status                  String   @default("pending") // "pending" | "processing" | "completed" | "failed" | "requires_review"
  attemptCount            Int      @default(0)
  nextAttemptAt           DateTime?
  lastAttemptAt           DateTime?
  deliveredAt             DateTime?

  lastHttpStatus          Int?
  lastErrorCode           String?
  lastErrorSafeMessage    String?  // Safe to display
  
  externalRequestId       String?  // GHL response ID for tracking
  idempotencyKey          String   @unique // Same key across all retries
  payloadHash             String   @unique // Hash of the payload, not full payload
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([intakeId])
  @@index([sessionId])
  @@index([status])
  @@index([nextAttemptAt])
  @@index([idempotencyKey])
}

// Append-only audit trail for all client consent and acknowledgments
// This table is legally immutable - no updates or deletes allowed
model ConsentAuditTrail {
  id                    String   @id @default(cuid())
  
  sessionId             String
  session               PhotographySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  intakeId              String?
  intake                SessionIntake? @relation(fields: [intakeId], references: [id], onDelete: SetNull)

  // Consent type - what was the user consenting to?
  consentType           String   // "photo_release" | "image_usage" | "data_collection" | "privacy_acknowledgment" | "agreement_acceptance"
  
  // The actual consent text/version the user agreed to
  consentText           String   @db.Text // Store full text for legal reference
  consentVersion        String   @default("1.0") // Version of consent form
  
  // Consent decision
  userConsented         Boolean  // true = agreed, false = declined
  
  // Consent metadata
  consentGivenAt        DateTime // When user submitted consent (client's local time)
  submittedIpHash       String?  // SHA-256 hash of IP (never raw IP for privacy)
  userAgentSummary      String?  // e.g., "Chrome 126.0 / Windows 10"
  
  // Optional e-signature/digital signature
  digitalSignature      String?  // Base64 encoded signature image or hash
  signatureMethod       String?  // "typed_name" | "drawn_signature" | "esign_provider" | null
  esignProvider         String?  // e.g., "docusign" | "hellosign" | null
  
  // Read-only tracking
  createdAt             DateTime @default(now())
  
  // Indexes for legal audits
  @@index([sessionId])
  @@index([intakeId])
  @@index([consentType])
  @@index([consentGivenAt])
  @@index([userConsented])
  @@unique([sessionId, consentType, consentVersion, consentGivenAt])
}
