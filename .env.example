NEXT_PUBLIC_SITE_URL=https://secondskinboudoir.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@secondskinboudoir.com
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/[your_form_id]
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/[location_id]/webhook-trigger/[webhook_id]
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Database (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/second_skin_boudoir

# Session Prep Configuration
GHL_SESSION_PREP_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/[location_id]/webhook-trigger/[session_prep_webhook_id]
GHL_SESSION_PREP_WEBHOOK_ENABLED=true
SESSION_PREP_WEBHOOK_SCHEMA_VERSION=1.0
SESSION_PREP_MAX_RETRIES=5
SESSION_PREP_RETRY_BASE_SECONDS=60
SESSION_PREP_TOKEN_EXPIRY_DAYS=60
SESSION_PREP_SECURE=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=5
